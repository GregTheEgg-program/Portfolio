{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gregory-sherris-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-05-01",
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "public", "scripts"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/downloads/UpWeGoat.zip", "/downloads/RockPaperCity.zip",
      "/downloads/SurfingPoseidon.zip", "/downloads/TheTower.zip",
      "/downloads/UpWeGoat-Windows-Setup.exe", "/downloads/RockPaperCity-Windows-Setup.exe"
    ]
  }
}
